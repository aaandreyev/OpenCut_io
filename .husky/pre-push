echo "🔍 Checking types before push..."

# Check types in web app only if node_modules exists (dependencies installed)
if [ -f "apps/web/package.json" ] && [ -d "apps/web/node_modules" ]; then
  cd apps/web
  echo "📦 Running type check in apps/web..."
  bunx tsc --noEmit || {
    echo "❌ Type check failed! Please fix errors before pushing."
    exit 1
  }
  cd ../..
elif [ -f "apps/web/package.json" ]; then
  echo "⚠️  Skipping type check (dependencies not installed). CI will catch errors."
fi

echo "✅ Pre-push checks passed!"

